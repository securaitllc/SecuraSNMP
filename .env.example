APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=
VITE_MAPBOX_ACCESS_TOKEN=

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

GITHUB_REPO=securaitllc/SecuraSNMP
GITHUB_TOKEN=

# ============================================================================
# Docker / HTTPS deployment (used by docker-compose.yml)
# ============================================================================
# Certificate name. Use a public FQDN for a real Let's Encrypt cert (auto-renewed,
# port 80 must be reachable). With NO domain, set this to the host's management
# IP (e.g. 10.15.0.10): Caddy issues an internal-CA cert valid for that IP so
# HTTPS runs immediately — trust the root CA on admin machines (see README).
APP_DOMAIN=localhost

# Uncommon HTTPS port to avoid conflicts on the host. Keep it in sync with
# APP_URL and SANCTUM_STATEFUL_DOMAINS below.
HTTPS_PORT=34443

# Bind the published ports (HTTPS, 80, trap 162/udp) to ONE host interface.
# Leave 0.0.0.0 for all interfaces, or set the management NIC's IP to expose the
# service only on that interface.
BIND_IP=0.0.0.0

# Let's Encrypt expiry-notice email is optional and set in docker/Caddyfile
# (uncomment the `tls you@example.com` line); certs issue + renew without it.

# Serve secure-only cookies (default true since the app is behind HTTPS).
SESSION_SECURE_COOKIE=true

# In production set these to match your domain + HTTPS_PORT, e.g.:
#   APP_URL=https://snmp.example.com:34443
#   SANCTUM_STATEFUL_DOMAINS=snmp.example.com:34443
#   SESSION_DOMAIN=snmp.example.com

# Generate strong random values before deploying — NEVER commit real secrets:
#   APP_KEY=          # php artisan key:generate --show
#   DB_PASSWORD=      # openssl rand -base64 24
#   DB_ROOT_PASSWORD= # openssl rand -base64 24
# --- Monitoring poll cadence (seconds) ---
# Defaults to 300 (5 min). Lower for faster WAN detection/clear on critical
# edges, at the cost of more SSH/SNMP load. Floored at 30s.
# POLL_NEXTHOP_SECONDS=90
# POLL_INTERFACE_SECONDS=90
# POLL_EDGECONNECT_SECONDS=90
