# Nodus (SecuraSNMP) — Portainer stack environment variables.
# Paste these into the stack's "Environment variables" section in Portainer.
#
# ⚠️ RE-DEPLOYING AN EXISTING STACK: keep your CURRENT values for APP_KEY,
# DB_PASSWORD and DB_ROOT_PASSWORD. Changing APP_KEY invalidates all sessions +
# encrypted data (SSH/SNMP creds); changing the DB passwords won't match the
# existing mysql-data volume and the DB won't start.

# --- Network / TLS ---
BIND_IP=10.11.10.57                        # host IP the ports bind to
HTTPS_PORT=34443                           # Caddy HTTPS port
APP_DOMAIN=10.11.10.57                     # host in the Caddy cert / URL
APP_URL=https://10.11.10.57:34443
SANCTUM_STATEFUL_DOMAINS=10.11.10.57:34443
SESSION_DOMAIN=                            # leave blank for a bare-IP deploy

# --- Secrets (KEEP your existing values on a re-deploy) ---
APP_KEY=base64:REPLACE_WITH_EXISTING_APP_KEY
DB_PASSWORD=REPLACE_WITH_EXISTING_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_EXISTING_DB_ROOT_PASSWORD
GITHUB_TOKEN=                              # optional: for the in-app update check

# --- Monitoring ---
TRAP_COMMUNITY=public                      # SNMP trap community (match your devices)
POLL_NEXTHOP_SECONDS=90
POLL_INTERFACE_SECONDS=300
POLL_EDGECONNECT_SECONDS=90

# --- Email alerts (optional; leave MAIL_MAILER=log to disable) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=alerts@securasnmp.local
MAIL_FROM_NAME=Nodus Alerts
